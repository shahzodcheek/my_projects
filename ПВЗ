  .unavailable { background: #fcf1e4; }
  button, select { font: inherit; min-height: 44px; max-width: 100%; margin: 3px 0; }
  button { border: 1px solid #316552; border-radius: 7px; padding: 5px 10px; background: #fff; color: #154739; }
  button:first-of-type { background: #174b3b; color: #fff; }
  button:focus-visible, select:focus-visible { outline: 3px solid #9b6100; outline-offset: 2px; }
